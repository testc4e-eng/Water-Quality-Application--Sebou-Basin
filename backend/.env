# =====================================================
# 🌍 ENVIRONNEMENT
# =====================================================
ENV=development
DEBUG=true


# =====================================================
# 🗄️ BASE DE DONNÉES POSTGRESQL
# =====================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=abh_sebou
DB_USER=postgres
DB_PASS=c4e@test@2025

# Options DB
DB_CONNECT_TIMEOUT=5
DB_APP_NAME=sad_sebou_api
DB_SSLMODE=
DB_POOL_MIN=1
DB_POOL_MAX=10


# =====================================================
# 📊 TABLES MÉTIERS (UTILISÉES PAR LES ROUTERS)
# =====================================================

# Stations
STATIONS_TABLE=public.stations_abhs

# Mesures
TBL_DEBIT=public.mesures_debit_jr
TBL_TEMP=public.mesures_temperatures_jr
TBL_QUAL=public.mesures_qualite_rivieres


# =====================================================
# 🗺️ COUCHES SIG (LAYERS)
# =====================================================
LAYER_BASSIN=public.bassin_sebou
LAYER_SOUS_BASSIN=public.sous_bassin_sebou
LAYER_RESEAU_HYDRO=public.reseau_hydro_abhs
LAYER_BARRAGES=public.barrages_abhs
LAYER_STATIONS=public.stations_abhs

LAYER_ADM_REGIONS=public.adm_regions_abhs
LAYER_ADM_PROVINCES=public.adm_provinces_abhs
LAYER_ADM_CERCLES=public.adm_cercles_abhs
LAYER_ADM_COMMUNES=public.adm_communes_abhs
LAYER_ADM_VILLES=public.adm_villes_abhs
LAYER_ADM_DOUARS=public.adm_douars_abhs


# =====================================================
# 🔐 SÉCURITÉ / AUTH (JWT)
# =====================================================
SECRET_KEY=d69376179183adc8d8e469214be3353f5855e85b018d0f43f8c42b45917f171e
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256


# =====================================================
# 🌐 CORS (FRONTEND)
# =====================================================
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001



# =====================================================
# 🗺️ MAP / API EXTERNES
# =====================================================
MAPTILER_KEY=PUT_YOUR_KEY_HERE


# =====================================================
# 🧪 DATES PAR DÉFAUT (DASHBOARD / TESTS)
# =====================================================
DEFAULT_DATE_FROM=2025-08-01
DEFAULT_DATE_TO=2025-09-01



# =========================================
# BASE CLIMAT (Dashboard Climate)
# =========================================
CLIMATE_DB_HOST=127.0.0.1
CLIMATE_DB_PORT=5432
CLIMATE_DB_NAME=my_bd
CLIMATE_DB_USER=postgres
CLIMATE_DB_PASS=c4e@test@2025
CLIMATE_DB_SSLMODE=
CLIMATE_DB_POOL_MIN=1
CLIMATE_DB_POOL_MAX=5

# frontend/.env — configuration API du frontend SAD Sebou
# 8010 = stack Docker locale ; 8000 = backend natif
VITE_API_BASE_URL=http://localhost:8010/api/v1
VITE_API_BASE=http://localhost:8010/api/v1
VITE_API_PROXY=http://localhost:8010

# Clé MapTiler (fond de carte) — obtenir une clé sur https://cloud.maptiler.com
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=PUT_YOUR_KEY_HERE

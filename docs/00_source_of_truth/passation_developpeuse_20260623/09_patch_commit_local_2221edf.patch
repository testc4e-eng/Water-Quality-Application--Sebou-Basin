+                                     {valDisplay}
+                                   </span>
+                                 )}
+                               </div>
+                             </div>
+                           </div>
+                         </div>
+                       );
+                    })}
+                  </div>
+                </AccordionContent>
+              </AccordionItem>
+            </Accordion>
+          )}
+          </>
+        )}
+      </div>
+    </div>
+  );
+}
